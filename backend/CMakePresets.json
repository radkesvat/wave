{
  "version": 3,
  "configurePresets": [
    {
      "name": "backend",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/../build/${presetName}"
    },
    {
      "name": "backend-debug",
      "inherits": "backend",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "backend-release",
      "inherits": "backend",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "backend-debug",
      "configurePreset": "backend-debug"
    },
    {
      "name": "backend-release",
      "configurePreset": "backend-release"
    }
  ],
  "testPresets": [
    {
      "name": "backend",
      "hidden": true,
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "backend-debug",
      "inherits": "backend",
      "configurePreset": "backend-debug"
    },
    {
      "name": "backend-release",
      "inherits": "backend",
      "configurePreset": "backend-release"
    }
  ]
}
