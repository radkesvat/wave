{
  "version": 3,
  "configurePresets": [
    {
      "name": "ninja",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}"
    },
    {
      "name": "web",
      "hidden": true,
      "inherits": "ninja",
      "toolchainFile": "$env{EMSDK}/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake",
      "cacheVariables": {
        "WAVE_ENABLE_UI_DEMOS": "OFF"
      }
    },
    {
      "name": "web-debug",
      "inherits": "web",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "web-release",
      "inherits": "web",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "backend-debug",
      "inherits": "ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "backend-release",
      "inherits": "ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "web-debug",
      "configurePreset": "web-debug"
    },
    {
      "name": "web-release",
      "configurePreset": "web-release"
    },
    {
      "name": "backend-debug",
      "configurePreset": "backend-debug"
    },
    {
      "name": "backend-release",
      "configurePreset": "backend-release"
    }
  ],
  "testPresets": [
    {
      "name": "wave-tests",
      "hidden": true,
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "web-debug",
      "inherits": "wave-tests",
      "configurePreset": "web-debug"
    },
    {
      "name": "web-release",
      "inherits": "wave-tests",
      "configurePreset": "web-release"
    },
    {
      "name": "backend-debug",
      "inherits": "wave-tests",
      "configurePreset": "backend-debug"
    },
    {
      "name": "backend-release",
      "inherits": "wave-tests",
      "configurePreset": "backend-release"
    }
  ]
}
